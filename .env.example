# OpenAI API key (required for --backend openai transcription + LLM analysis)
# Get your key at: https://platform.openai.com/api-keys
# Usage: python src/main.py --video samples/example.mp4 --backend openai
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM model to use for linguistic analysis (optional)
# Default: gpt-5.4-mini
# Examples: gpt-4o, gpt-4o-mini, o3-mini, o4-mini
LLM_MODEL=gpt-5.4-mini
